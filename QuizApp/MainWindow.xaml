<Window x:Class="QuizApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конструктор квизов — вариант 20" Height="720" Width="1080"
        MinHeight="650" MinWidth="940" WindowStartupLocation="CenterScreen"
        Background="#F3F5FA">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="КОНСТРУКТОР КВИЗОВ" FontSize="25" FontWeight="Bold" Foreground="#202747"/>
            <TextBlock Text="Создание квиза и управление вопросами с сохранением в SQL Server"
                       FontSize="13" Foreground="#68708A" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.0*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Параметры квиза" FontSize="18" FontWeight="SemiBold"
                               Foreground="#202747" Margin="0,0,0,10"/>
                    <TextBlock Text="Название квиза" Foreground="#505873"/>
                    <TextBox x:Name="QuizTitleTextBox" Text="Основы C#" />
                    <TextBlock Text="Сложность вопроса" Foreground="#505873" Margin="4,8,0,0"/>
                    <ComboBox x:Name="DifficultyComboBox" SelectedIndex="0">
                        <ComboBoxItem Content="Легко"/>
                        <ComboBoxItem Content="Средне"/>
                        <ComboBoxItem Content="Сложно"/>
                    </ComboBox>
                    <TextBlock Text="Настройки" FontSize="16" FontWeight="SemiBold"
                               Foreground="#202747" Margin="4,18,0,6"/>
                    <CheckBox x:Name="TimerCheckBox" Content="Ограничение по времени" Margin="5,5"
                              Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <CheckBox x:Name="HintsCheckBox" Content="Разрешить подсказки" Margin="5,5"
                              Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <GroupBox Header="Формат прохождения" Margin="4,18,4,8" Padding="10">
                        <StackPanel>
                            <RadioButton x:Name="OnePassRadioButton" Content="Однопроходное"
                                         IsChecked="True" Margin="3,5" GroupName="QuizMode"
                                         Checked="Option_Changed"/>
                            <RadioButton x:Name="ReturnRadioButton" Content="С возвратом"
                                         Margin="3,5" GroupName="QuizMode" Checked="Option_Changed"/>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock x:Name="OptionsInfoLabel" Text="Режим: однопроходное"
                               Foreground="#5267D8" TextWrapping="Wrap" Margin="5,8,0,0"/>
                    <TextBlock Text="Название, настройки и вопросы формируют параметры квиза."
                               Foreground="#7A8298" TextWrapping="Wrap" Margin="5,18,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Вопросы квиза (база данных)" FontSize="18" FontWeight="SemiBold"
                               Foreground="#202747" Margin="0,0,0,10"/>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Текст вопроса" Foreground="#505873"/>
                        <TextBox x:Name="QuestionTextBox" MinHeight="38" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="Сложность выбранного вопроса" Foreground="#505873" Margin="4,6,0,0"/>
                        <ComboBox x:Name="EditDifficultyComboBox" SelectedIndex="0">
                            <ComboBoxItem Content="Легко"/>
                            <ComboBoxItem Content="Средне"/>
                            <ComboBoxItem Content="Сложно"/>
                        </ComboBox>
                        <WrapPanel Margin="0,8,0,10">
                            <Button Content="＋ Добавить" Click="AddQuestion_Click"/>
                            <Button Content="Сохранить изменения" Click="UpdateQuestion_Click"/>
                            <Button Content="Очистить поля" Click="ClearFields_Click" Background="#737B91"/>
                        </WrapPanel>
                    </StackPanel>
                    <ListBox x:Name="QuestionsListBox" Grid.Row="2" SelectionChanged="QuestionsListBox_SelectionChanged"
                             BorderBrush="#E1E5F0" Padding="5" DisplayMemberPath="Text"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Удалить выбранный" Click="DeleteQuestion_Click" Background="#D95D68"/>
                        <Button Content="Обновить список" Click="Refresh_Click" Background="#737B91"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#E9ECF8" CornerRadius="8" Padding="12" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock x:Name="QuestionCountLabel" Text="Вопросов: 0" FontWeight="SemiBold" Foreground="#303B70"/>
                <TextBlock x:Name="StatusLabel" Text="Подключение к базе данных..." Foreground="#59627D"
                           DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
